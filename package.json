{
  "name": "touchline-manager",
  "version": "0.2.0",
  "private": true,
  "description": "An unofficial football management sim in the spirit of Championship Manager 01/02: real 2026/27 squads across six countries and fourteen divisions, in one HTML page.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "test": "tsx --test tests/engine.test.ts tests/pyramid.test.ts tests/fixes.test.ts tests/round2.test.ts",
    "balance": "tsx tools/balance.ts 20",
    "tactics-lab": "tsx tools/tactics-lab.ts",
    "test:quick": "tsx --test tests/fixes.test.ts"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
